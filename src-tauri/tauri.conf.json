{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "nextEnglish",
  "version": "0.1.0",
  "identifier": "digital.overdose.nextenglish",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nextEnglish",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "**/_work/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
